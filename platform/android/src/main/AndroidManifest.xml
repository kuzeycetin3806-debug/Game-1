<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Godot v2 plugin registration: singleton name = SehirNotifications -->
        <meta-data
            android:name="org.godotengine.plugin.v2.SehirNotifications"
            android:value="com.nefeskent.notifications.SehirNotificationsPlugin" />

        <receiver
            android:name="com.nefeskent.notifications.NotificationReceiver"
            android:exported="false" />
    </application>
</manifest>
